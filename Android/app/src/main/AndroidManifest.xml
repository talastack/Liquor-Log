<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions, still. Export hands its file to another app through
         a FileProvider rather than writing to shared storage, which is what
         WRITE_EXTERNAL_STORAGE would have been for; the camera and the
         network come later, with the features that need them.

         The theme is the platform's own, not a Material Components one: that
         theme lives in com.google.android.material, which a Compose app has
         no other reason to depend on. Compose draws every pixel above it
         anyway; all the Android theme has to do is stay out of the way. -->

    <application
        android:label="Liquor Log"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android has refused file:// URIs across app boundaries since
             Nougat. This grants read access to one cache directory for the
             life of one share intent, which is the whole of what export
             needs. The database is not reachable through it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
