// Copy to IOS/Secrets.xcconfig and fill in. That file is gitignored.
//
//     cp IOS/Secrets.example.xcconfig IOS/Secrets.xcconfig
//
// Both values come from the Supabase dashboard: Project Settings -> API.
//
// HOST ONLY, no https:// -- in xcconfig "//" starts a comment, so a full URL
// truncates to "https:" and the app fails as if the network were down.
SUPABASE_HOST = abcdefghijklm.supabase.co

// The anon / publishable key. NOT a secret: it ships in every binary and RLS is
// what protects the data. Never put the SERVICE ROLE key here -- it bypasses
// RLS completely and anything in an app bundle is readable by anybody.
SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.example
