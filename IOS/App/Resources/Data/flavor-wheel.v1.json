      "note": "Oak, char and time."
    },
    {
      "key": "oxidation",
      "label": "From air and time",
      "note": "Appears as an open bottle ages."
    },
    {
      "key": "fault",
      "label": "Something went wrong",
      "note": "A flaw rather than a characteristic."
    }
