{
  "version": 1,
  "name": "Liquor-Log flavour wheel",
  "provenance": "Own work. Descriptors are the ordinary sensory vocabulary in common use and are not owned by anyone. The grouping is by ORIGIN - where the flavour comes from in the grain, the ferment, the still or the barrel - which is a chemical and process fact rather than a copy of any published wheel's arrangement. See docs/06-flavour-wheel-provenance.md.",
  "origins": [
    { "key": "grain", "label": "From the grain", "note": "The mashbill itself." },
    { "key": "fermentation", "label": "From the ferment", "note": "Made by yeast. Esters, mostly fruit and flowers." },
    { "key": "distillation", "label": "From the still", "note": "Congeners carried or created during distillation." },
    { "key": "maturation", "label": "From the barrel", "note": "Oak, char and time." },
    { "key": "oxidation", "label": "From air and time", "note": "Appears as an open bottle ages." },
    { "key": "fault", "label": "Something went wrong", "note": "Present above threshold, not desirable." }
  ],
